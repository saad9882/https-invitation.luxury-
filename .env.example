# ============================================================
# INVITATION LUXURY — PRODUCTION ENVIRONMENT VARIABLES
# ============================================================

# 1. Base Application Domain & URL
NEXT_PUBLIC_APP_URL=https://invitation.luxury
NEXT_PUBLIC_BASE_DOMAIN=invitation.luxury

# 2. Server Authentication Secret
AUTH_SECRET=your_production_auth_secret_32_bytes_random_string

# 3. Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wedding_app?retryWrites=true&w=majority

# 4. Stripe Payment Gateway Integration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# 5. Optional Integrations
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
